// M324 LU04c Exercise 4/5: development-cycle pipeline for the traffic light app
// Needs the NodeJS plugin and a NodeJS installation named 'node'
// (Manage Jenkins > Tools > NodeJS installations).
pipeline {
    agent any

    tools {
        nodejs 'node'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/im23b-nothelferl/M324_trafficlight.git'
            }
        }
        stage('Install') {
            steps {
                sh 'node --version'
                sh 'npm --version'
                sh 'npm install --no-audit --no-fund'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
    }
}
